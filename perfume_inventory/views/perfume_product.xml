<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="perfume_product_view_form" model="ir.ui.view">
        <field name="name">perfume.product.view.form</field>
        <field name="model">perfume.product</field>
        <field name="arch" type="xml">
            <form string="Add new perfume brand">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" />
                    </h1>
                    <group>
                        <group>
                            <field
                                class="border w-50"
                                name="logo"
                                nolabel="1"
                                filename="logo_name"
                                widget="image" />
                            <field name="logo_name" invisible="1" />
                        </group>
                        <group>
                            <field name="brand_id" />
                            <field name="name" />
                            <field name="year" />
                            <field name="gender" />
                            <field name="accord_ids" widget="many2many_tags" />
                            <field name="perfumer_ids" widget="many2many_tags" />
                            <field name="stock" />
                            <field name="price" />
                            <field name="currency_id" />
                        </group>
                    </group>
                    <!-- <notebook>
                        <page string="Perfumes">
                            <field name="perfume_ids">
                                <list>
                                    <field name="logo" widget="image" options="{'size': [64, 64]}" />
                                    <field name="name" />
                                    <field name="gender" />
                                    <field name="stock" />
                                </list>
                            </field>
                        </page>
                </notebook> -->
                </sheet>
                
            </form>
        </field>
    </record>

    <record id="perfume_product_view_list" model="ir.ui.view">
        <field name="name">perfume.product.view.list</field>
        <field name="model">perfume.product</field>
        <field name="arch" type="xml">
            <list string="Add new perfume">
                <field name="logo" widget="image" options="{'size': [64, 64]}" />
                <field name="name" />
                <field name="brand_id" />
                <field name="gender" />
                <field name="price" />
                <field name="currency_id" invisible="1" nolabel="1" />
                <field name="stock" />
            </list>
        </field>
    </record>
</odoo>