<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="sale_order_quotations_view_extend" model="ir.ui.view">
            <field name="name">sale.order.quotations.list</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <list position="replace">
                    <list>
                        <field name="accord_names" />
                        <field name="accord_colors" />
                        <field name="accord_percentages" />
                    </list>
                </list>
            </field>
        </record>

        <record id="sale_order_view_extend" model="ir.ui.view">
        <field name="name">sale.order.view.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
               <button name="display_all_accords" type="object" class="oe_stat_button" icon="fa-home" string="Display accords"  />
            </div>
            <xpath expr="//group/field[@name='payment_term_id']" position="after">
                    <field name="accord_ids" widget="many2many_tags" />
                    <field name="accord_names" />
                    <field name="accord_colors" />
                    <field name="accord_percentages" />
            </xpath>
        </field>
    </record>
</odoo>