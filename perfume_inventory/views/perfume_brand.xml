<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="perfume_brand_view_form" model="ir.ui.view">
        <field name="name">perfume.brand.view.form</field>
        <field name="model">perfume.brand</field>
        <field name="arch" type="xml">
            <form string="Add new perfume brand">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" />
                    </h1>
                    <group>
                        <group>
                            <field
                                class="border w-50"
                                name="logo"
            
                                filename="logo_name"
                                widget="image" />
                            <field name="logo_name" invisible="1" />
                            <field name="name" />
                            <field name="country" />
                            <field name="total_count" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Perfumes">
                            <field name="perfume_ids">
                                <list>
                                    <field name="logo" widget="image" options="{'size': [64, 64]}" />
                                    <field name="name" />
                                    <field name="gender" />
                                    <field name="stock" />
                                </list>
                            </field>
                        </page>
                </notebook>
                </sheet>
                
            </form>
        </field>
    </record>

    <record id="perfume_brand_view_list" model="ir.ui.view">
        <field name="name">perfume.brand.view.list</field>
        <field name="model">perfume.brand</field>
        <field name="arch" type="xml">
            <list string="Add new perfume brand">
                <field name="logo" widget="image" options="{'size': [64, 64]}" />
                <field name="name" />
                <field name="country" />
                <field name="total_count" />
            </list>
        </field>
    </record>
</odoo>